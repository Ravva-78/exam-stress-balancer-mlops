# ─────────────────────────────────────────────────────────────────────────────
# Exam Stress Balancer — Environment Variables Example
# Copy to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=exam-stress-balancer

# ── Training ──────────────────────────────────────────────────────────────────
TRAIN_EPISODES=500
TRAIN_LR=0.1
TRAIN_GAMMA=0.95
TRAIN_EPSILON=1.0
TRAIN_EPS_MIN=0.01
TRAIN_EPS_DECAY=0.995
TRAIN_SEED=42

# ── Evaluation ────────────────────────────────────────────────────────────────
EVAL_EPISODES=100
EVAL_MAX_STEPS=200
EVAL_SEED=0

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
